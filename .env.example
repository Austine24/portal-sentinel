# Copy to .env and fill in. NEVER commit .env.
# Values below are intentionally EMPTY until verified (see docs/PORTALDOT_VERIFIED_FACTS.md).

# Portaldot V3 testnet (EVM JSON-RPC over HTTPS)
PORTALDOT_EVM_RPC_URL=
PORTALDOT_CHAIN_ID=

# Request timeout when calling the chain, in seconds
PORTALDOT_TIMEOUT_SECONDS=10

# Frontend origin allowed by CORS (exact origin, never "*")
FRONTEND_ORIGIN=http://localhost:5173
