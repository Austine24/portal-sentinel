# Copy to backend/.env and fill in. NEVER commit .env.

# Database. Use a dedicated user, not root. URL-encode special characters in the password.
# Example: mysql+pymysql://sentinel:YOUR_PASSWORD@127.0.0.1:3306/portal_sentinel?charset=utf8mb4
# Leave empty to use a local SQLite file for zero-setup development.
DATABASE_URL=

# Portaldot V3 testnet. Public values announced by the organizers on 2026-10-16 (not secrets).
# See docs/PORTALDOT_VERIFIED_FACTS.md.
PORTALDOT_SUBSTRATE_HTTP_URL=https://test-node-v3.portaldot.dev
PORTALDOT_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
PORTALDOT_SUBSTRATE_WS_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_EXPLORER_URL=https://node-console.portaldot.dev

# Network health monitoring
NETWORK_WINDOW_BLOCKS=60
NETWORK_MIN_REFRESH_SECONDS=10

# Request timeout when calling the chain, in seconds
PORTALDOT_TIMEOUT_SECONDS=10

# Frontend origin allowed by CORS (exact origin, never "*")
FRONTEND_ORIGIN=http://localhost:5173

# NEVER put a private key or seed phrase in this file or anywhere in the repository.
